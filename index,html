<script>
// ═══════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════
let prospects = JSON.parse(localStorage.getItem('iw_prospects') || '[]');
let campana   = JSON.parse(localStorage.getItem('iw_campana')   || 'null');
let imgData   = localStorage.getItem('iw_img') || null;
let sendFilter = 'all';

// ═══════════════════════════════════════════════
//  UTILS
// ═══════════════════════════════════════════════
function save() {
  localStorage.setItem('iw_prospects', JSON.stringify(prospects));
  localStorage.setItem('iw_campana', JSON.stringify(campana));
  if (imgData) localStorage.setItem('iw_img', imgData);
  else localStorage.removeItem('iw_img');
  updateStats();
}

function uid() { return Date.now() + Math.random().toString(36).slice(2,6); }

function toast(msg, type='') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (type ? ' ' + type : '');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 3500);
}

function updateStats() {
  const total   = prospects.length;
  const sent    = prospects.filter(p => p.sent).length;
  const pending = total - sent;
  const pct     = total ? Math.round((sent / total) * 100) : 0;

  ['sTotal','mTotal'].forEach(id => document.getElementById(id).textContent = total);
  ['sSent','mSent'].forEach(id   => document.getElementById(id).textContent = sent);
  ['sPending','mPending'].forEach(id => document.getElementById(id).textContent = pending);

  document.getElementById('mSentPct').textContent = pct + '% completado';
  document.getElementById('dashPct').textContent  = pct + '%';
  document.getElementById('dashBar').style.width  = pct + '%';
  document.getElementById('envPct').textContent   = pct + '%';
  document.getElementById('envBar').style.width   = pct + '%';
  document.getElementById('envTotal').textContent   = total;
  document.getElementById('envSent').textContent    = sent;
  document.getElementById('envPending').textContent = pending;

  if (campana) {
    document.getElementById('dashCampana').innerHTML =
      `<strong style="color:var(--text)">${campana.nombre || 'Sin nombre'}</strong>
       <button class="btn btn-sm btn-outline" style="margin-left:8px" onclick="goPage('campana')">✏️ Editar</button>`;
    document.getElementById('envCampNombre').textContent = campana.nombre || 'Campaña activa';
    document.getElementById('dashTip').textContent = `${sent} de ${total} mensajes enviados.`;
  }
}

// ═══════════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════════
function goPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  document.getElementById('nb-' + id).classList.add('active');
  if (id === 'prospectos') renderTable();
  if (id === 'enviar')     renderSendList();
  if (id === 'campana')    loadCampanaForm();
  updateStats();
}

// ═══════════════════════════════════════════════
//  PROSPECTS CRUD
// ═══════════════════════════════════════════════
function openModal(id) {
  document.getElementById('editId').value    = id || '';
  document.getElementById('modalTitle').textContent = id ? 'Editar Prospecto' : 'Agregar Prospecto';
  if (id) {
    const p = prospects.find(x => x.id === id);
    if (!p) return;
    document.getElementById('pNombre').value  = p.nombre;
    document.getElementById('pNegocio').value = p.negocio;
    document.getElementById('pWa').value      = p.wa;
    document.getElementById('pCiudad').value  = p.ciudad || '';
    document.getElementById('pSector').value  = p.sector || '';
  } else {
    ['pNombre','pNegocio','pWa','pCiudad','pSector'].forEach(f => document.getElementById(f).value = '');
  }
  document.getElementById('modalProspect').classList.add('show');
}

function closeModal() {
  document.getElementById('modalProspect').classList.remove('show');
}

function saveProspect() {
  const nombre  = document.getElementById('pNombre').value.trim();
  const negocio = document.getElementById('pNegocio').value.trim();
  const wa      = document.getElementById('pWa').value.trim().replace(/\D/g,'');
  const ciudad  = document.getElementById('pCiudad').value.trim();
  const sector  = document.getElementById('pSector').value.trim();
  const editId  = document.getElementById('editId').value;

  if (!nombre || !negocio || !wa) { toast('⚠️ Nombre, negocio y WhatsApp son obligatorios.',''); return; }
  if (wa.length < 10) { toast('⚠️ Número de WhatsApp inválido.',''); return; }

  if (editId) {
    const idx = prospects.findIndex(p => p.id === editId);
    if (idx > -1) prospects[idx] = { ...prospects[idx], nombre, negocio, wa, ciudad, sector };
    toast('✅ Prospecto actualizado.','green');
  } else {
    prospects.push({ id: uid(), nombre, negocio, wa, ciudad, sector, sent: false });
    toast('✅ Prospecto agregado.','green');
  }
  save(); closeModal(); renderTable();
}

function deleteProspect(id) {
  if (!confirm('¿Eliminar este prospecto?')) return;
  prospects = prospects.filter(p => p.id !== id);
  save(); renderTable(); toast('🗑 Prospecto eliminado.');
}

function markSent(id, val) {
  const p = prospects.find(x => x.id === id);
  if (p) { p.sent = val; save(); renderSendList(); renderTable(); }
}

function resetAll() {
  if (!confirm('¿Resetear todos los envíos a pendiente?')) return;
  prospects.forEach(p => p.sent = false);
  save(); toast('🔄 Todos los envíos reseteados.'); updateStats();
}

// ═══════════════════════════════════════════════
//  TABLE RENDER
// ═══════════════════════════════════════════════
function renderTable() {
  const q = (document.getElementById('searchInput')?.value || '').toLowerCase();
  const filtered = prospects.filter(p =>
    p.nombre.toLowerCase().includes(q) ||
    p.negocio.toLowerCase().includes(q) ||
    p.wa.includes(q)
  );
  const tbody = document.getElementById('tableBody');
  const empty = document.getElementById('emptyState');

  if (!filtered.length) {
    tbody.innerHTML = ''; empty.style.display = 'block'; return;
  }
  empty.style.display = 'none';
  tbody.innerHTML = filtered.map((p, i) => `
    <tr>
      <td style="color:var(--muted);font-size:11px">${i+1}</td>
      <td><strong>${p.nombre}</strong></td>
      <td>${p.negocio}</td>
      <td class="td-wa">${p.wa}</td>
      <td style="color:var(--muted)">${p.ciudad || '—'}</td>
      <td style="color:var(--muted)">${p.sector || '—'}</td>
      <td>
        ${p.sent
          ? '<span class="badge badge-sent"><span class="badge-dot"></span>Enviado</span>'
          : '<span class="badge badge-pending"><span class="badge-dot"></span>Pendiente</span>'}
      </td>
      <td>
        <div class="actions-col">
          <button class="btn btn-outline btn-sm" onclick="openModal('${p.id}')">✏️</button>
          <button class="btn btn-danger btn-sm" onclick="deleteProspect('${p.id}')">🗑</button>
        </div>
      </td>
    </tr>
  `).join('');
}

// ═══════════════════════════════════════════════
//  CSV IMPORT
// ═══════════════════════════════════════════════
function importCSV(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const lines = e.target.result.split('\n').filter(l => l.trim());
    let added = 0;
    lines.slice(1).forEach(line => {
      const cols = line.split(',').map(c => c.trim().replace(/^"|"$/g,''));
      const [nombre, negocio, wa, ciudad, sector] = cols;
      if (nombre && negocio && wa) {
        prospects.push({ id: uid(), nombre, negocio, wa: wa.replace(/\D/g,''), ciudad: ciudad||'', sector: sector||'', sent: false });
        added++;
      }
    });
    save(); renderTable();
    toast(`✅ ${added} prospectos importados.`, 'green');
  };
  reader.readAsText(file);
  input.value = '';
}

