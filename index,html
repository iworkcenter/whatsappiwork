];

function initNichos() {
  if (!nichos) {
    nichos = NICHOS_DEFAULT.map(n => ({...n}));
    saveNichos();
  }
}

function saveNichos() {
  localStorage.setItem('iw_nichos', JSON.stringify(nichos));
  localStorage.setItem('iw_imgnich', JSON.stringify(imgNichos));
}

function loadCampanaForm() {
  initNichos();
  if (campana) {
    document.getElementById('campNombre').value = campana.nombre || '';
  }
  renderNichoTabs();
  renderNichoResumen();
  // Cargar imagen global si existe
  if (imgData) {
    document.getElementById('imgPreview').src = imgData;
    document.getElementById('imgPreview').style.display = 'block';
    document.getElementById('waImgPreview').src = imgData;
    document.getElementById('waImgPreview').style.display = 'block';
    document.getElementById('btnRemoveImg').style.display = 'inline-flex';
  }
}

function renderNichoTabs() {
  const tabs = document.getElementById('nichoTabs');
  tabs.innerHTML = nichos.map(n => `
    <button onclick="selectNicho('${n.id}')" style="
      padding:8px 14px;border-radius:20px;font-size:12px;font-weight:500;
      border:1px solid ${activeNicho===n.id ? 'var(--green)' : 'var(--border2)'};
      background:${activeNicho===n.id ? 'rgba(37,211,102,.1)' : 'transparent'};
      color:${activeNicho===n.id ? 'var(--green)' : 'var(--muted)'};
      cursor:pointer;transition:all .2s;
    ">${n.nombre}${imgNichos[n.id] ? ' 🖼️' : ''}</button>
  `).join('');
}

function selectNicho(id) {
  activeNicho = id;
  const n = nichos.find(x => x.id === id);
  if (!n) return;

  document.getElementById('nichoMsgLabel').textContent = n.nombre;
  document.getElementById('nichoImgLabel').textContent = n.nombre;
  document.getElementById('nichoEmptyHint').style.display = 'none';
  document.getElementById('nichoMsgArea').style.display = 'block';
  document.getElementById('campMsg').value = n.msg || '';

  // Cargar imagen del nicho si tiene
  const ni = imgNichos[id];
  if (ni) {
    document.getElementById('imgPreview').src = ni;
    document.getElementById('imgPreview').style.display = 'block';
    document.getElementById('waImgPreview').src = ni;
    document.getElementById('waImgPreview').style.display = 'block';
    document.getElementById('btnRemoveImg').style.display = 'inline-flex';
  } else {
    document.getElementById('imgPreview').style.display = 'none';
    document.getElementById('waImgPreview').style.display = 'none';
    document.getElementById('btnRemoveImg').style.display = 'none';
  }

  renderNichoTabs();
  updatePreview();
}

function saveNichoMsg() {
  if (!activeNicho) { toast('⚠️ Selecciona un nicho primero.'); return; }
  const msg = document.getElementById('campMsg').value.trim();
  if (!msg) { toast('⚠️ El mensaje no puede estar vacío.'); return; }
  const n = nichos.find(x => x.id === activeNicho);
  if (n) {
    n.msg = msg;
    // guardar también imagen del nicho si hay una cargada
    const prev = document.getElementById('imgPreview');
    if (prev.style.display !== 'none' && prev.src) {
      imgNichos[activeNicho] = prev.src;
    }
    saveNichos();
    renderNichoResumen();
    renderNichoTabs();
    toast('✅ Mensaje de ' + n.nombre + ' guardado.', 'green');
  }
}

function addNicho() {
  const inp  = document.getElementById('newNichoName');
  const name = inp.value.trim();
  if (!name) { toast('⚠️ Escribe el nombre del nicho.'); return; }
  const id = name.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
  if (nichos.find(n => n.id === id)) { toast('⚠️ Ese nicho ya existe.'); return; }
  nichos.push({ id, nombre: name, msg: '' });
  saveNichos();
  inp.value = '';
  renderNichoTabs();
  renderNichoResumen();
  selectNicho(id);
  toast('✅ Nicho "' + name + '" creado.', 'green');
}

function deleteNicho() {
  if (!activeNicho) return;
  const n = nichos.find(x => x.id === activeNicho);
  if (!confirm('¿Eliminar el nicho "' + (n ? n.nombre : '') + '"?')) return;
  nichos = nichos.filter(x => x.id !== activeNicho);
  delete imgNichos[activeNicho];
  activeNicho = null;
  saveNichos();
  document.getElementById('nichoMsgArea').style.display = 'none';
  document.getElementById('nichoEmptyHint').style.display = 'block';
  document.getElementById('nichoMsgLabel').textContent = 'selecciona un nicho';
  document.getElementById('nichoImgLabel').textContent = 'selecciona un nicho';
  renderNichoTabs();
  renderNichoResumen();
  toast('🗑 Nicho eliminado.');
}

function renderNichoResumen() {
  const el = document.getElementById('nichoResumen');
  if (!nichos || !nichos.length) {
    el.innerHTML = '<div class="empty"><div class="empty-icon">🎯</div>No hay nichos configurados.</div>';
    return;
  }
  el.innerHTML = nichos.map(n => `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);gap:12px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:16px">${n.nombre.split(' ')[0]}</span>
        <div>
          <div style="font-size:13px;font-weight:500">${n.nombre.replace(/^\S+\s*/,'')}</div>
          <div style="font-size:11px;color:var(--muted)">${n.msg ? n.msg.slice(0,60)+'...' : 'Sin mensaje configurado'}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        ${imgNichos[n.id] ? '<span style="font-size:10px;color:var(--accent);background:rgba(192,132,252,.08);border:1px solid rgba(192,132,252,.2);padding:2px 8px;border-radius:10px">🖼️ Con imagen</span>' : ''}
        ${n.msg ? '<span style="font-size:10px;color:var(--success);background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);padding:2px 8px;border-radius:10px">✅ Listo</span>' : '<span style="font-size:10px;color:var(--warn);background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);padding:2px 8px;border-radius:10px">⚠️ Sin mensaje</span>'}
        <button class="btn btn-outline btn-sm" onclick="selectNicho('${n.id}');document.querySelector('.nav-btn[onclick*=campana]').click()">✏️ Editar</button>
      </div>
    </div>
  `).join('');
}

function saveCampana() {
  const nombre = document.getElementById('campNombre').value.trim();
  campana = { nombre: nombre || 'Campaña sin nombre' };
  save();
  toast('✅ Campaña guardada.', 'green');
}

function updatePreview() {
  const msg = document.getElementById('campMsg')?.value || '';
  const preview = msg
    .replace(/{{nombre}}/g,  '<Nombre>')
    .replace(/{{negocio}}/g, '<Negocio>')
    .replace(/{{ciudad}}/g,  '<Ciudad>')
    .replace(/{{sector}}/g,  '<Sector>');
  document.getElementById('previewMsg').textContent = preview || 'Tu mensaje aparecerá aquí...';
}

function insertVar(v) {
  const ta = document.getElementById('campMsg');
  const s  = ta.selectionStart, e = ta.selectionEnd;
  ta.value = ta.value.slice(0, s) + v + ta.value.slice(e);
  ta.focus();
  ta.selectionStart = ta.selectionEnd = s + v.length;
  updatePreview();
}

// ═══════════════════════════════════════════════
//  IMAGE
// ═══════════════════════════════════════════════
function loadImage(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) { toast('⚠️ Imagen demasiado grande. Máx 5MB.'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    const src = e.target.result;
    if (activeNicho) {
      imgNichos[activeNicho] = src;
      saveNichos();
      renderNichoTabs();
    } else {
      imgData = src;
      localStorage.setItem('iw_img', src);
    }
    document.getElementById('imgPreview').src   = src;
    document.getElementById('imgPreview').style.display = 'block';
    document.getElementById('waImgPreview').src = src;
    document.getElementById('waImgPreview').style.display = 'block';
    document.getElementById('btnRemoveImg').style.display = 'inline-flex';
    toast('✅ Imagen cargada' + (activeNicho ? ' para este nicho.' : '.'), 'green');
  };
  reader.readAsDataURL(file);
}

function removeImg() {
  if (activeNicho) {
    delete imgNichos[activeNicho];
    saveNichos();
    renderNichoTabs();
  } else {
    imgData = null;
    localStorage.removeItem('iw_img');
  }
  document.getElementById('imgPreview').style.display = 'none';
  document.getElementById('waImgPreview').style.display = 'none';
  document.getElementById('btnRemoveImg').style.display = 'none';
}

function downloadImg() {
  if (!imgData) return;
  const a = document.createElement('a');
  a.href = imgData; a.download = 'campana-iwork.jpg'; a.click();
}

// ═══════════════════════════════════════════════
//  SEND LIST
// ═══════════════════════════════════════════════
function filterSend(f) {
  sendFilter = f;
  ['all','pending','sent'].forEach(x => {
    const btn = document.getElementById('fb' + x.charAt(0).toUpperCase() + x.slice(1));
    if (btn) btn.style.color = x === f ? 'var(--green)' : '';
    if (btn) btn.style.borderColor = x === f ? 'rgba(37,211,102,.4)' : '';
  });
  renderSendList();
}

function buildMsg(prospect) {
  // Buscar mensaje del nicho que coincide con el sector del prospecto
  initNichos();
  let msg = '';
  if (prospect.sector && nichos) {
    const sector = prospect.sector.toLowerCase();
    const nicho  = nichos.find(n =>
      sector.includes(n.id) ||
      n.nombre.toLowerCase().includes(sector) ||
      sector.includes(n.nombre.toLowerCase().replace(/^[^a-z]*/,'').trim())
    );
    if (nicho && nicho.msg) msg = nicho.msg;
  }
  // Si no hay match de nicho, usar el primer nicho con mensaje
  if (!msg && nichos) {
    const fallback = nichos.find(n => n.msg);
    if (fallback) msg = fallback.msg;
  }
  if (!msg) return 'Hola ' + prospect.nombre + ', te contactamos de I WORK Centro de Experiencia de AI.';
  return msg
    .replace(/{{nombre}}/g,  prospect.nombre)
    .replace(/{{negocio}}/g, prospect.negocio)
    .replace(/{{ciudad}}/g,  prospect.ciudad || '')
    .replace(/{{sector}}/g,  prospect.sector || '');
}

function getNichoImg(prospect) {
  initNichos();
  if (!prospect.sector || !nichos) return imgData;
  const sector = prospect.sector.toLowerCase();
  const nicho  = nichos.find(n =>
    sector.includes(n.id) ||
    n.nombre.toLowerCase().includes(sector) ||
    sector.includes(n.nombre.toLowerCase().replace(/^[^a-z]*/,'').trim())
  );
  if (nicho && imgNichos[nicho.id]) return imgNichos[nicho.id];
  return imgData; // fallback imagen global
}

let currentSendId = null;

function openWA(id) {
  if (!nichos || !nichos.length) { toast('⚠️ Configura al menos un nicho con mensaje primero.'); goPage('campana'); return; }
  const p = prospects.find(x => x.id === id);
  if (!p) return;
  currentSendId = id;
  const texto = buildMsg(p);
  const nombre = p.nombre.split(' ')[0];

  // Mostrar modal guía
  document.getElementById('envModalTitle').textContent = 'Enviando a ' + nombre;
  document.getElementById('envModalSub').textContent   = p.negocio + ' · ' + p.wa;

  // Si hay imagen — auto-descargar y mostrar paso 2
  const nichoImg = getNichoImg(p);
  const fname = 'campana-' + p.nombre.replace(/\s+/g,'-').toLowerCase() + '.jpg';
  if (nichoImg) {
    document.getElementById('paso2img').style.display = 'flex';
    document.getElementById('imgFileName').textContent = fname;
    const prev = document.getElementById('envImgPreview');
    prev.src = nichoImg; prev.style.display = 'block';
    // Auto-descargar imagen del nicho correspondiente
    autoDownloadImgSrc(nichoImg, fname);
  } else {
    document.getElementById('paso2img').style.display = 'none';
  }

  document.getElementById('modalEnvio').classList.add('show');

  // Abrir WhatsApp inmediatamente
  window.open('https://wa.me/' + p.wa + '?text=' + encodeURIComponent(texto), '_blank');
}

function autoDownloadImgSrc(src, fname) {
  if (!src) return;
  const a = document.createElement('a');
  a.href = src;
  a.download = fname || 'campana-iwork.jpg';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

function autoDownloadImg(fname) {
  if (!imgData) return;
  autoDownloadImgSrc(imgData, fname);
}

function reDownloadImg() {
  const p    = currentSendId ? prospects.find(x => x.id === currentSendId) : null;
  const ni   = p ? getNichoImg(p) : imgData;
  const fname = p ? 'campana-' + p.nombre.replace(/\s+/g,'-').toLowerCase() + '.jpg' : 'campana-iwork.jpg';
  autoDownloadImgSrc(ni || imgData, fname);
  toast('⬇️ Imagen descargada de nuevo.', 'green');
}

function confirmarEnvio() {
  if (currentSendId) {
    const p = prospects.find(x => x.id === currentSendId);
    if (p) { p.sent = true; save(); renderSendList(); renderTable(); }
    toast('✅ Marcado como enviado.', 'green');
  }
  document.getElementById('modalEnvio').classList.remove('show');
  currentSendId = null;
}

function cancelarEnvio() {
  document.getElementById('modalEnvio').classList.remove('show');
  currentSendId = null;
}

function renderSendList() {
  const list = document.getElementById('sendList');
  let filtered = prospects;
  if (sendFilter === 'pending') filtered = prospects.filter(p => !p.sent);
  if (sendFilter === 'sent')    filtered = prospects.filter(p => p.sent);

  // Imagen ref
  if (imgData) {
    document.getElementById('imgRefCard').style.display = 'block';
    document.getElementById('imgRef').src = imgData;
  } else {
    document.getElementById('imgRefCard').style.display = 'none';
  }

  if (!filtered.length) {
    list.innerHTML = `<div class="empty"><div class="empty-icon">${sendFilter === 'sent' ? '✅' : '📋'}</div>${sendFilter === 'sent' ? 'Aún no has marcado ningún mensaje como enviado.' : 'No hay prospectos pendientes. ¡Gran trabajo!'}</div>`;
    return;
  }

  list.innerHTML = filtered.map(p => `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border);gap:12px;flex-wrap:wrap">
      <div style="flex:1;min-width:160px">
        <div style="font-size:14px;font-weight:500;margin-bottom:2px">${p.nombre}</div>
        <div style="font-size:12px;color:var(--muted)">${p.negocio} ${p.ciudad ? '· ' + p.ciudad : ''}</div>
        <div style="font-family:'DM Mono',monospace;font-size:10px;color:rgba(255,255,255,.25);margin-top:2px">${p.wa}</div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        ${p.sent
          ? `<span class="badge badge-sent"><span class="badge-dot"></span>Enviado</span>
             <button class="btn btn-outline btn-sm" onclick="markSent('${p.id}', false)" title="Desmarcar">↩️</button>`
          : `<button class="btn btn-green btn-sm" onclick="openWA('${p.id}')">💬 Enviar</button>`
        }
      </div>
    </div>
  `).join('');
}

// ═══════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════
if (imgData) {
  document.getElementById('imgPreview').src   = imgData;
  document.getElementById('imgPreview').style.display = 'block';
  document.getElementById('waImgPreview').src = imgData;
  document.getElementById('waImgPreview').style.display = 'block';
  document.getElementById('btnRemoveImg').style.display = 'inline-flex';
}

initNichos();
updateStats();
renderTable();
</script>
